{
  "name": "hostelsplit",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run db:migrate",
    "dev": "vite dev",
    "prebuild": "node scripts/prepare-pages.mjs",
    "build": "vite build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "node --import tsx scripts/seed.ts",
    "bot": "node --import tsx bot/index.ts",
    "smoke": "node --import tsx scripts/smoke.ts",
    "deploy": "npm run db:migrate && npm run build && wrangler pages deploy .svelte-kit/cloudflare --project-name hostelsplit --branch main"
  },
  "dependencies": {
    "@libsql/client": "^0.15.0",
    "@sveltejs/kit": "^2.70.3",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "bcryptjs": "^3.0.0",
    "dotenv": "^18.0.4",
    "drizzle-orm": "^0.45.3",
    "qrcode-terminal": "^0.12.0",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-cloudflare": "^7.2.9",
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.0.0",
    "@vite-pwa/sveltekit": "^1.1.0",
    "drizzle-kit": "^0.31.0",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.141.0"
  }
}
